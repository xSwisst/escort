# Web App Backend Configuration

# Server
API_PORT=8004

# Telegram Bot (токен бота, в котором открывается Mini App - для проверки initData)
WEB_APP_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Web App User Session (секрет для подписи пользовательских JWT сессий фронтенда)
WEB_APP_SESSION_SECRET=change-me-use-openssl-rand-hex-32
WEB_APP_SESSION_TTL_HOURS=24
WEB_APP_ENABLE_MOCK_SESSION=false

# Internal Microservices (внутренние URL внутри Docker сети)
API_BASE_URL=http://api:8000
API_SECRET_KEY=change-me-use-openssl-rand-hex-32
API_AUDIENCE=escort_api

# Logs Service (внутренний сервис логов)
LOGS_API_URL=http://logs:8006
LOGS_SECRET_KEY=shared-logs-secret-key

# Public Media (публичный адрес сервиса фото для картинок на фронтенде)
PHOTOS_API_URL=https://photos.domain.com

# Links & Channels (ссылки для кнопок в меню Mini App)
WEB_APP_TITLE=Escort Mini App
WEB_APP_INFO_CHANNEL_URL=https://t.me/escort_info
WEB_APP_REVIEWS_CHANNEL_URL=https://t.me/escort_reviews
WEB_APP_SUPPORT_BOT_URL=https://t.me/escort_support_bot
