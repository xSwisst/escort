WEB_APP_REVIEWS_CHANNEL_URL=https://t.me/escort_reviews
WEB_APP_SUPPORT_BOT_URL=https://t.me/escort_support_bot

# Dev mode (для тестирования без Telegram)
WEB_APP_ENABLE_MOCK_SESSION=false
