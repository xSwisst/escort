# Photos Service Configuration

# Server
API_PORT=8005

# Service-to-service JWT
API_SECRET_KEY=change-me-use-openssl-rand-hex-32
API_AUDIENCE=photos_service

# Storage
PHOTOS_STORAGE_PATH=/data/photos
PHOTOS_MAX_FILE_SIZE_MB=15

# Public access
PHOTOS_SCHEME=https
PHOTOS_DOMAIN=photos.domain.com
PHOTOS_WATERMARK_ENABLED=true
PHOTOS_WATERMARK_TEXT=elegant-agency.fun
PHOTOS_WATERMARK_OPACITY=115
