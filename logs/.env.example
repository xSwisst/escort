# Logs Service Configuration

# Server
API_PORT=8006

# Service-to-service JWT
LOGS_SECRET_KEY=shared-logs-secret-key
API_AUDIENCE=escort_logs

# Telegram Bot
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
BOT_USERNAME=@escort_logs_bot
LOGS_CHAT_ID=-1001234567890

# Webhook
WEBHOOK_URL=https://your-domain.com/webhook/logs
WEBHOOK_SECRET_TOKEN=generate-a-strong-secret-token
