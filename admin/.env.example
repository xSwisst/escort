# Webhook
WEBHOOK_URL=https://your-domain.com/webhook/admin
WEBHOOK_SECRET_TOKEN=generate-a-strong-secret-token

# Database & Redis
DATABASE_URL=postgresql+asyncpg://escort:escort_password@postgres:5432/escort
REDIS_URL=redis://redis:6379/2

# External services
LOGS_API_URL=http://logs:8006
LOGS_SECRET_KEY=shared-logs-secret-key

# Admin Access
OWNER_ID=123456789
ADMIN_ALLOWED_IDS=123456789,987654321
ADMIN_RESULTS_PER_PAGE=8
